<?xml version="1.0"?>
<configuration>
  <system.web>
    <compilation targetFramework="4.5" debug="true"/>
    <pages controlRenderingCompatibilityVersion="4.0" clientIDMode="AutoID" validateRequest="false"/>
    <httpRuntime requestValidationMode="2.0"/>
  </system.web>
  <location allowOverride="true">
    <appSettings>
      <!-- 全國門牌地址定位服務 -->
      <!-- TGOSQueryAddrAppId-->
      <add key="TGOSQueryAddrAppId" value="yourID"/>
      <!-- TGOSQueryAddrAPIKey-->
      <add key="TGOSQueryAddrAPIKey" value="yourKey"/>
      <!-- QueryAddr:網址-->
      <add key="TGOS_Query_Addr_Url" value="https://addr.tgos.tw/addrws/v40/QueryAddr.asmx" />
      <!-- 坐標回傳門牌服務 -->
      <!-- TGOSQueryGeoAddrAppId-->
      <add key="TGOSQueryGeoAddrAppId" value="yourID"/>
      <!-- TGOSQueryGeoAddrAPIKey-->
      <add key="TGOSQueryGeoAddrAPIKey" value="yourKey"/>
      <!-- GeoQueryAddr:網址-->
      <add key="TGOS_Query_GeoAddr_Url" value="WmsUrl"/>
      <!-- 全國門牌清單查詢服務 -->
      <!-- TGOSQueryAddrAppId-->
      <add key="TGOSQueryAddrListAppId" value="yourID"/>
      <!-- TGOSQueryAddrAPIKey-->
      <add key="TGOSQueryAddrListAPIKey" value="yourKey"/>
      <!-- GetAddrList:網址-->
      <add key="TGOS_Query_AddrList_Url" value="WmsUrl"/>
    </appSettings>
  </location>
</configuration>